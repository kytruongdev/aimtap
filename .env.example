# Global platform secrets (root-level, not per app).
# Copy to .env.local (git-ignored) and fill in real values.

# Claude API key — used from Phase 2. Leave empty in Phase 1.
ANTHROPIC_API_KEY=

# --- Operational configuration (optional; defaults shown) ---

# Log level: debug | info | warn | error. Defaults to info.
LOG_LEVEL=

# Root directory for results and reports. Defaults to <cwd>/output.
AIMTAP_OUTPUT_DIR=

# AI features (self-healing, generation) land in Phase 2. 'true' | 'false'. Defaults to false.
AIMTAP_AI_ENABLED=

# Shared wait budget overrides. Default: timeout 10000ms, interval 500ms, retries 2.
AIMTAP_WAIT_TIMEOUT_MS=
AIMTAP_WAIT_INTERVAL_MS=
AIMTAP_WAIT_RETRIES=
